
&НаСервере
Функция ПолучитьОтветОтGigaChat(ТекстПромпта)
    Токен = ПолучитьТокенGigaChat(); // OAuth2, живёт 30 минут
    
    Соединение = Новый HTTPСоединение("ngw.devices.sberbank.ru", , , , , 30);
    Запрос = Новый HTTPЗапрос("/api/v2/chat/completions");
    Запрос.Заголовки.Вставить("Authorization", "Bearer " + Токен);
    Запрос.Заголовки.Вставить("Content-Type", "application/json");
    
    Сообщения = Новый Массив;
    Сообщение = Новый Структура("role", "user", "content", ТекстПромпта);
    Сообщения.Добавить(Сообщение);
    
    Тело = Новый Структура;
    Тело.Вставить("model", "GigaChat-Pro");
    Тело.Вставить("messages", Сообщения);
    Тело.Вставить("temperature", 0.2);
    
    Запрос.УстановитьТелоИзСтроки(ЗаписатьJSON(Тело));
    Ответ = Соединение.Получить(Запрос).ПолучитьТелоКакСтроку();
    
    Данные = ПрочитатьJSON(Ответ);
    Возврат Данные.choices[0].message.content;
КонецФункции
