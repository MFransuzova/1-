&НаКлиенте
Процедура СоздатьБазуИзСписка(Команда)
	ПараметрыДанных = Новый Структура;
	МассВыбранных = Элементы.ИнформационныеБазы.ВыделенныеСтроки; 
	
	МассивДанных = Новый Массив;
	Для каждого эл из  МассВыбранных Цикл
		ТекСтр = Элементы.ИнформационныеБазы.ДанныеСтроки(эл);
		СК = Новый Структура;
		СК.Вставить("СтрокаСоединения",СокрЛП(ТекСтр.СтрокаСоединения));
		СК.Вставить("НаименованиеБазы",СокрЛП(ТекСтр.НаименованиеБазы));   
		МассивДанных.Добавить(СК);
	КонецЦикла;
	Если МассивДанных.Количество()=0 Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыДанных.Вставить("МассВыбранных",МассивДанных);
	СоздатьБазуИзСпискаНаСервере(ПараметрыДанных);  
	Заполнить();
КонецПроцедуры
