&НаСервере
Процедура УдалитьИзРегистраТалонНаСервере() 
	СтруктураДанных = Новый Структура;   
	СтрокиТалонов = Элементы.ВремяТалонов.ВыделенныеСтроки;
	Если НЕ СтрокиТалонов.Количество()=0 Тогда  
		
		МассивСтрок = Новый Массив;    
		Для каждого стр из СтрокиТалонов Цикл   
			МассивСтрок.Добавить(ВремяТалонов.НайтиПоИдентификатору(стр));
		КонецЦикла;
		
		СтруктураДанных.Вставить("МассивСтрок",МассивСтрок); 
	КонецЕсли;
	ТЗ = ВремяТалонов.Выгрузить(СтруктураДанных.МассивСтрок);
КонецПроцедуры

&НаКлиенте
Процедура УдалитьИзРегистраТалон(Команда)  
	
	УдалитьИзРегистраТалонНаСервере();        
	
КонецПроцедуры
