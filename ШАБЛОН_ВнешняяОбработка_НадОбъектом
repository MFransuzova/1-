Функция СведенияОВнешнейОбработке() Экспорт
	
	Назначения = Новый Массив ;
	Назначения.Добавить("Документ.торо_ИзменениеПоложенияВСтруктуреИерархии") ;
	
	ПараметрыРегистрации = Новый Структура ;
	ПараметрыРегистрации.Вставить("Вид","ЗаполнениеОбъекта");
	ПараметрыРегистрации.Вставить("Назначение",Назначения);
	ПараметрыРегистрации.Вставить("Наименование","ПодборОбъектовИерархии");
	ПараметрыРегистрации.Вставить("Версия","1.0");
	ПараметрыРегистрации.Вставить("Информация","Подбор объектов иерархии");
	ПараметрыРегистрации.Вставить("БезопасныйРежим",Истина);
	
	Команды = ПолучитьТаблицуКоманд() ;
	ДобавитьКоманду(Команды, "Подбор объектов иерархии","Расш1_ПодборОбъектовИерархии","ВызовКлиентскогоМетода",Ложь,) ;
	ПараметрыРегистрации.Вставить("Команды",Команды) ;
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

Функция ПолучитьТаблицуКоманд()
	Команды = Новый ТаблицаЗначений ;
	Команды.Колонки.Добавить("Представление",Новый ОписаниеТипов("Строка")) ;   //  Новый Картинка) ;//
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка")) ;
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка")) ;
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево")) ;
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка")) ;   
//	Команды.Колонки.Добавить("Картинка", Новый Картинка(БиблиотекаКартинок.Печать)) ;
	Возврат Команды ;
КонецФункции	

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")
	НоваяКоманда = ТаблицаКоманд.Добавить() ;
	НоваяКоманда.Представление = Представление ;
	НоваяКоманда.Идентификатор = Идентификатор ;
	НоваяКоманда.Использование = Использование ;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение ;
	НоваяКоманда.Модификатор = Модификатор ;   
	//НоваяКоманда.Картинка = БиблиотекаКартинок.Печать ;
КонецПроцедуры	


&НаСервере
Процедура Расш1_ПодборОбъектовИерархии(Структура)  Экспорт    
	Если НЕ Структура.Свойство("Объект") Тогда   
		Структура.Вставить("Отказ",Истина);
		//Возврат Структура;
	КонецЕсли;
	
	Объект = Структура.Объект;
	//Возврат Объект;
КонецПроцедуры
