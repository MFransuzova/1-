&НаСервере
Процедура ЗаполнитьСтруктуруИерархии()
	ИерархияПодбора = РеквизитФормыВЗначение("СписокПодбора");
	Запрос = Новый Запрос;
	Запрос.Текст = "
	
	|ВЫБРАТЬ РАЗЛИЧНЫЕ 
	|Рег.СтруктураИерархии,
	|УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Рег.СтруктураИерархии)
	|ПОМЕСТИТЬ СтруктурыИ
	|ИЗ РегистрСведений.торо_ПорядокОРПоИерархии КАК Рег
	|ГДЕ Рег.СтруктураИерархии=&УИД
	
	|;
	|ВЫБРАТЬ ПЕРВЫЕ 100000000 
	|Рег.ОбъектРемонта,
	|Рег.РеквизитДопУпорядочиванияОР ,
	|Рег.СтруктураИерархии ,
	|РегРасп.РодительИерархии
	|ИЗ РегистрСведений.торо_ПорядокОРПоИерархии КАК Рег  
	|ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.торо_РасположениеОРВСтруктуреИерархии.СрезПоследних КАК РегРасп 
	|ПО Рег.ОбъектРемонта =  РегРасп.ОбъектИерархии  И Рег.СтруктураИерархии = РегРасп.СтруктураИерархии  
	|ГДЕ  Рег.СтруктураИерархии В (ВЫБРАТЬ СтруктурыИ.СтруктураИерархии ИЗ СтруктурыИ КАК СтруктурыИ) 
	|	УПОРЯДОЧИТЬ ПО
	|Рег.РеквизитДопУпорядочиванияОР
	|";
	Запрос.УстановитьПараметр("УИД",Справочники.торо_СтруктурыОР.ПолучитьСсылку(Новый УникальныйИдентификатор("d339e733-b6ab-11ed-94c8-005056b233c6")));
	РезультатЗапроса = Запрос.ВыполнитьПакетСПромежуточнымиДанными();  
	
	СоответствиеДанных = Новый Соответствие;
	Выборка = РезультатЗапроса[0].Выгрузить(); 
	ПодГруппы = РезультатЗапроса[1].Выгрузить();  
	Для каждого стр из Выборка Цикл   
		
		старыйКлюч =стр.СтруктураИерархии;  
		ПроверитьСоответствиеНаДобавление(СоответствиеДанных,старыйКлюч);
		
		СоответствиеДанныхНовое = СоответствиеДанных.Получить(старыйКлюч);    
		МассивВершин = Новый Массив;   
		
		Отбор = Новый Структура;
		Отбор.Вставить("СтруктураИерархии",старыйКлюч);
		РекурсияДерева(СоответствиеДанныхНовое,старыйКлюч,ПодГруппы,МассивВершин,Отбор);
		СоответствиеДанных.Вставить(старыйКлюч,СоответствиеДанныхНовое);
		МассивВершин.Добавить(старыйКлюч);
	КонецЦикла; 
	
	
	Для каждого эл из СоответствиеДанных Цикл     
		НайдСтрока = ИерархияПодбора.Строки.Найти(эл.Ключ, "СтруктураИерархии");
		Если НЕ НайдСтрока = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяГруппа1 = ИерархияПодбора.Строки.Добавить();  
		НоваяГруппа1.СтруктураИерархии = эл.Ключ;  
		значенияГруппы = эл.Значение; 
		МассивВершин = Новый Массив;
		Если ТипЗнч(значенияГруппы) = Тип("Соответствие") Тогда  
			Если НЕ значенияГруппы.Количество()=0 Тогда
				ВывестиВДерево(НоваяГруппа1,значенияГруппы,МассивВершин); 
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;      
	
	ЗначениеВРеквизитФормы(ИерархияПодбора,"СписокПодбора");	
КонецПроцедуры


&НаСервере
Процедура ВывестиВДерево(Корень,значенияГруппы,МассивВершин)  
	Для каждого эл из значенияГруппы Цикл  
		Ключ = эл.Ключ;       
		НовыйКорень = Корень.Строки.Добавить();   
		НовыйКорень.СтруктураИерархии = Ключ; 
		значенияГруппыНов = эл.Значение;  
		Если НЕ ЗначениеЗаполнено(значенияГруппыНов) Тогда 
			Продолжить;	
		КонецЕсли;
		Если НЕ МассивВершин.Найти(Ключ)= Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		МассивВершин.Добавить(Ключ);
		Если НЕ значенияГруппыНов.Количество()=0 Тогда   
			ВывестиВДерево(НовыйКорень,значенияГруппыНов,МассивВершин) ;
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры
