&НаСервере
Процедура РекурсияДерева(СоответствиеДанных,Ключ,ПодГруппы,МассивВершин,Отбор)  

	НайденыПодгруппы = ПодГруппы.НайтиСтроки(Отбор);  
	
	Если НайденыПодгруппы.Количество()=0 Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого эл из  НайденыПодгруппы Цикл 
		новыйКлюч = эл.ОбъектРемонта;  
		ПроверитьСоответствиеНаДобавление(СоответствиеДанных,новыйКлюч);
		
		СоответствиеДанныхНовое1 = СоответствиеДанных.Получить(новыйКлюч);
		
		Если НЕ МассивВершин.Найти(новыйКлюч)= Неопределено Тогда
			Продолжить;
		КонецЕсли;   
		Отбор = Новый Структура;
    	Отбор.Вставить("РодительИерархии",новыйКлюч);
		РекурсияДерева(СоответствиеДанныхНовое1,новыйКлюч,ПодГруппы,МассивВершин,Отбор) ; 
		СоответствиеДанных.Вставить(новыйКлюч,СоответствиеДанныхНовое1);  
		МассивВершин.Добавить(новыйКлюч);
	КонецЦикла;
КонецПроцедуры
