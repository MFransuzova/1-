&НаСервере
Процедура РМ_УдилитьСтрокиТалонов(Структура) Экспорт

	Если НЕ Структура.Свойство("ТЗ") Тогда
		Возврат;
	КонецЕсли;

	Для каждого стр Из Структура.ТЗ Цикл

		Запись = РегистрыСведений.ТалоныРабочихМест.СоздатьМенеджерЗаписи();

		СК = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(стр);
		СК.Вставить("МедицинскоеРабочееМесто", СК.РМ);
		ЗаполнитьЗначенияСвойств(Запись, СК);

		Запись.Удалить();

	КонецЦикла;

КонецПроцедуры
